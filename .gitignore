# Regras gerais do monorepo. Cada projeto (mobile/, web/, backend/) tem o próprio .gitignore
# com as regras específicas da sua stack.

# Segredos — vale para qualquer pasta
.env
.env*.local

# Dependências
node_modules/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.idea/
*.iml

# Logs
*.log
